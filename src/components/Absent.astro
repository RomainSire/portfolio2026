---
/**
 * Emplacement sans capture. Pas de mockup générique, pas de « à venir » nu :
 * un panneau typographique, traité comme un parti pris. L'absence d'image sur
 * un produit médical en dit plus long qu'une image inventée.
 */
interface Props {
	raison: string;
	stack: string[];
	grand?: boolean;
	/** Rayon diagonal en tête du panneau, le même que sur l'image de partage. */
	rayon?: boolean;
}
const { raison, stack, grand = false, rayon = false } = Astro.props;
---

<div class:list={["absent", { grand }]}>
	{
		rayon && (
			<svg class="rayon" viewBox="0 0 24 24" aria-hidden="true">
				<path d="M2 15V10A8 8 0 0 1 10 2H15" />
				<path d="M22 9V14A8 8 0 0 1 14 22H9" />
			</svg>
		)
	}
	<p class="chrome liste">{stack.join(" · ")}</p>
	<p class="raison caption">{raison}</p>
</div>

<style>
	.absent {
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 10px;
		height: 100%;
		min-height: 180px;
		padding: 20px;
		border: var(--hair) solid var(--rule);
		border-radius: var(--r-panel) 0 var(--r-panel) 0;
		background:
			repeating-linear-gradient(
				to bottom,
				transparent 0 31.5px,
				color-mix(in srgb, var(--kasumi) 8%, transparent) 31.5px 32px
			);
	}
	.absent.grand {
		min-height: clamp(220px, 34vw, 380px);
		padding: clamp(24px, 4vw, 40px);
	}
	.rayon {
		width: clamp(56px, 16vw, 72px);
		height: auto;
		margin-bottom: auto;
		fill: none;
		stroke: var(--fg);
		stroke-width: 2.6;
		stroke-linecap: butt;
	}
	.grand .rayon {
		width: clamp(88px, 14vw, 160px);
	}
	.liste {
		color: var(--fg);
	}
	.raison {
		color: var(--fg-muted);
		max-width: 44ch;
	}
</style>
