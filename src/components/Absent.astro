---
import Monogram from "./Monogram.astro";

/**
 * Emplacement sans capture. Pas de mockup générique, pas de « à venir » nu :
 * un panneau typographique, traité comme un parti pris. L'absence d'image sur
 * un produit médical en dit plus long qu'une image inventée.
 */
interface Props {
	raison: string;
	stack: string[];
	grand?: boolean;
}
const { raison, stack, grand = false } = Astro.props;
---

<div class:list={["absent", { grand }]}>
	<Monogram size={grand ? 96 : 52} class="decor wm" />
	<p class="chrome liste">{stack.join(" · ")}</p>
	<p class="raison caption">{raison}</p>
</div>

<style>
	.absent {
		position: relative;
		overflow: hidden;
		display: flex;
		flex-direction: column;
		justify-content: flex-end;
		gap: 10px;
		height: 100%;
		min-height: 180px;
		padding: 20px;
		border: var(--hair) solid var(--rule);
		border-radius: var(--r-panel) 0 var(--r-panel) 0;
		background:
			repeating-linear-gradient(
				to bottom,
				transparent 0 31.5px,
				color-mix(in srgb, var(--kasumi) 8%, transparent) 31.5px 32px
			);
	}
	.absent.grand {
		min-height: clamp(220px, 34vw, 380px);
		padding: clamp(24px, 4vw, 40px);
	}
	.wm {
		position: absolute;
		top: 18px;
		right: 18px;
		color: var(--fg);
		opacity: 0.07;
	}
	.grand .wm {
		top: clamp(24px, 4vw, 40px);
		right: clamp(24px, 4vw, 40px);
	}
	.liste {
		color: var(--fg);
	}
	.raison {
		color: var(--fg-muted);
		max-width: 44ch;
	}
</style>
