---
const path = Astro.url.pathname.replace(/\/$/, "") || "/";
const nav = [
	{ href: "/", label: "Travaux" },
	{ href: "/a-propos", label: "À propos" },
	{ href: "/contact", label: "Contact" },
];
const isCurrent = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));
---

<header class="head">
	<div class="shell row">
		<a href="/" class="brand" aria-label="Romain Siré — accueil">
			<span class="name">Romain Siré<span class="shu" aria-hidden="true"></span></span>
		</a>
		<nav aria-label="Principale">
			<ul class="links">
				{
					nav.map((n) => (
						<li>
							<a href={n.href} aria-current={isCurrent(n.href) ? "page" : undefined}>
								{n.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
	<hr class="rule" />
</header>

<style>
	.head {
		position: sticky;
		top: 0;
		z-index: 10;
		background: color-mix(in srgb, var(--bg) 88%, transparent);
		backdrop-filter: blur(10px);
	}
	.row {
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: clamp(12px, 4vw, var(--gutter));
		min-height: 64px;
	}
	.brand {
		text-decoration: none;
	}
	.brand:hover {
		color: inherit;
	}
	.name {
		font-size: var(--t-body);
		font-weight: 600;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}
	/* La navigation se compose en sans, au corps d'un intitulé mais avec la
	   graisse d'un lien, pas celle d'un titre.
	   Aucun intitulé ne se coupe : à 320 px, le nom et la navigation tiennent
	   sur une ligne, sans quoi « À propos » passerait à la ligne. */
	.links {
		font-family: var(--sans);
		font-size: var(--t-caption);
		font-weight: 400;
		color: var(--fg-muted);
		line-height: 1.2;
		display: flex;
		gap: clamp(12px, 3vw, 32px);
		white-space: nowrap;
	}
	.links a {
		text-decoration: none;
		padding-block: 4px;
		border-bottom: var(--hair) solid transparent;
		transition:
			color var(--dur-fast) var(--ease),
			border-color var(--dur-fast) var(--ease);
	}
	.links a:hover,
	.links a[aria-current="page"] {
		color: var(--fg);
		border-bottom-color: var(--rule-strong);
	}
</style>
