---
/**
 * Le monogramme SR. Vectorisé depuis la charte v1.0 — segments droits et arcs
 * d'un rayon unique. Ne jamais faire subir au signe : rotation, contour,
 * dégradé, ombre, déformation non proportionnelle.
 */
interface Props {
	size?: number;
	/** Trace le signe au premier chargement. Exception unique. ADR-0002. */
	seal?: boolean;
	class?: string;
}
const { size = 32, seal = false, class: cls = "" } = Astro.props;
const raw = (await import("../assets/monogram.svg?raw")).default;
const inner = raw.replace(/<\/?svg[^>]*>/g, "");
---

<span class:list={["mono", cls, { seal }]} style={`--s:${size}px`} aria-hidden={cls.includes("decor")}>
	<svg viewBox="0 0 125 110" fill="currentColor" fill-rule="evenodd" role="img" aria-label="Monogramme SR" set:html={inner} />
</span>

<style>
	.mono {
		display: inline-block;
		width: calc(var(--s) * 1.136);
		height: var(--s);
		color: currentColor;
	}
	.mono svg {
		width: 100%;
		height: 100%;
	}

	/* Exception unique à la règle des 320 ms : le signe se révèle par un
	   balayage en arc, une fois par session. Voir docs/adr/0002. */
	.seal svg {
		clip-path: inset(0 100% 0 0);
	}
	:global(html[data-seal="done"]) .seal svg {
		clip-path: none;
	}
	:global(html:not([data-seal="done"])) .seal svg {
		animation: seal var(--dur-seal) var(--ease) both;
	}
	@keyframes seal {
		from {
			clip-path: inset(0 100% 0 0);
		}
		to {
			clip-path: inset(0 0 0 0);
		}
	}
	@media (prefers-reduced-motion: reduce) {
		.seal svg {
			clip-path: none !important;
			animation: none !important;
		}
	}
</style>
