---
interface Props {
	title: string;
	description: string;
	/** Titre exact de l'onglet ; sinon « <title> · Romain Siré ». */
	rawTitle?: boolean;
}
const { title, description, rawTitle = false } = Astro.props;
const full = rawTitle ? title : `${title} · Romain Siré`;
const url = new URL(Astro.url.pathname, Astro.site);
const og = new URL("/og.png", Astro.site);
---

<title>{full}</title>
<meta name="description" content={description} />
<link rel="canonical" href={url} />
<meta property="og:type" content="website" />
<meta property="og:site_name" content="Romain Siré" />
<meta property="og:locale" content="fr_FR" />
<meta property="og:title" content={full} />
<meta property="og:description" content={description} />
<meta property="og:url" content={url} />
<meta property="og:image" content={og} />
<meta name="twitter:card" content="summary_large_image" />
