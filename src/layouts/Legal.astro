---
import Base from "./Base.astro";
interface Props {
	title: string;
	description: string;
	maj: string;
}
const { title, description, maj } = Astro.props;
---

<Base title={title} description={description} registre="galerie">
	<section class="shell wrap">
		<p class="chrome">Légal</p>
		<h1>{title}</h1>
		<p class="chrome maj">Dernière mise à jour · {maj}</p>
		<hr class="rule" />
		<div class="doc"><slot /></div>
	</section>
</Base>

<style>
	.wrap {
		padding-block: clamp(36px, 7vw, 72px) clamp(40px, 8vw, 80px);
	}
	.wrap > .chrome {
		margin-bottom: 20px;
	}
	h1 {
		font-size: var(--t-page);
		margin-bottom: 14px;
	}
	.maj {
		margin-bottom: 28px;
	}
	.doc {
		max-width: var(--measure);
		margin-top: 32px;
		font-size: var(--t-body);
	}
	.doc :global(h2) {
		font-size: var(--t-lead);
		font-weight: 500;
		letter-spacing: 0;
		margin-top: 2.4em;
		margin-bottom: 0.6em;
	}
	.doc :global(h2:first-child) {
		margin-top: 0;
	}
	.doc :global(p) {
		color: var(--fg-muted);
	}
	.doc :global(p + p) {
		margin-top: 1em;
	}
	.doc :global(ul) {
		color: var(--fg-muted);
		margin-top: 0.8em;
		display: grid;
		gap: 0.5em;
	}
	.doc :global(li) {
		padding-left: 1.1em;
		position: relative;
	}
	.doc :global(li)::before {
		content: "";
		position: absolute;
		left: 0;
		top: 0.7em;
		width: 6px;
		height: var(--hair);
		background: var(--rule-strong);
	}
	.doc :global(dt) {
		color: var(--fg);
		font-weight: 500;
		margin-top: 1em;
	}
	.doc :global(dd) {
		color: var(--fg-muted);
		margin: 0.2em 0 0;
	}
	.doc :global(.todo) {
		display: inline-block;
		background: color-mix(in srgb, var(--seal) 12%, transparent);
		border: var(--hair) solid var(--seal);
		color: var(--seal);
		padding: 1px 7px;
		border-radius: var(--r-control) 0 var(--r-control) 0;
		font-family: var(--mono);
		font-size: var(--t-chrome);
	}
</style>
