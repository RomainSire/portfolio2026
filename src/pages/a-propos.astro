---
import Base from "../layouts/Base.astro";
import Monogram from "../components/Monogram.astro";

const stack = {
	"Au quotidien": ["TypeScript", "React", "Astro", "Next.js", "CSS", "SASS"],
	"Aussi": ["NestJS", "Node.js", "PHP", "WordPress", "MySQL", "MongoDB"],
	"Environnement": ["Git", "Docker", "Linux", "Figma", "Vite"],
};
---

<Base
	title="À propos"
	registre="galerie"
	description="Dix ans d'ingénierie et d'énergies renouvelables, puis le développement web. Parcours, méthode et outils de Romain Siré."
>
	<section class="shell top">
		<p class="chrome">À propos</p>
		<h1 data-reveal>Je n'ai pas changé de métier.<br />J'ai changé d'outil.</h1>
	</section>

	<div class="shell body">
		<div class="txt measure">
			<p class="lead" data-reveal>
				Dix ans d'ingénierie, dont l'essentiel dans les énergies renouvelables. Puis le développement web, qui
				n'a pas remplacé ce travail : il l'a prolongé.
			</p>
			<p data-reveal>
				Ce parcours se voit encore dans ce que je fais. Chez <a href="/travaux/notrelec">Notrelec</a>, je travaille
				sur l'autoconsommation collective. Pour <a href="/travaux/lm-energie">LM Énergie</a>, sur le photovoltaïque.
				Je lis un schéma d'installation sans qu'on me le traduise, et je sais distinguer une contrainte
				réglementaire d'une préférence de client. Sur ces produits, ça change l'ordre des priorités.
			</p>
			<p data-reveal>
				Le reste du temps, j'ai travaillé sur des produits où une erreur ne reste pas à l'écran : trois ans sur
				une application de <a href="/travaux/thess">télésurveillance médicale</a>, dans une équipe de dix. J'y ai appris à
				reprendre du code que je n'avais pas écrit, à migrer sans arrêter la production, et à ne pas confondre
				l'élégance d'une réécriture avec l'intérêt du produit.
			</p>
			<p data-reveal>
				Je suis indépendant. Je travaille en missions longues, dans de petites équipes, où l'on attend de moi
				autre chose que des écrans : du design quand il en manque, du back quand il bloque, du déploiement, et
				de la formation quand il y a des alternants à faire monter.
			</p>
			<p data-reveal>
				Mes quatre derniers clients étaient à Toulouse, Montpellier et Perpignan. Les missions se font à
				distance — la plus longue a duré trois ans.
			</p>
			<p data-reveal>
				Je n'ai pas de secteur exclusif. Mais quand le sujet touche à l'énergie, je démarre avec dix ans d'avance.
			</p>
		</div>

		<aside class="side" data-reveal>
			<Monogram size={40} class="decor" />
			<dl class="facts chrome">
				<div><dt>Statut</dt><dd>Indépendant</dd></div>
				<div><dt>En mission</dt><dd>Notrelec</dd></div>
				<div><dt>Base</dt><dd>Toulouse · à distance</dd></div>
				<div><dt>Avant</dt><dd>Ingénierie · EnR, 10 ans</dd></div>
			</dl>
		</aside>
	</div>

	<section class="shell stack-wrap" aria-labelledby="s-t">
		<hr class="rule" />
		<h2 id="s-t" class="chrome lbl">Outils</h2>
		<div class="cols">
			{
				Object.entries(stack).map(([k, v]) => (
					<div data-reveal>
						<h3 class="chrome sub">{k}</h3>
						<ul class="chips chrome">
							{v.map((s) => (
								<li>{s}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>
</Base>

<style>
	.top {
		padding-block: clamp(36px, 7vw, 72px) clamp(20px, 3vw, 32px);
	}
	.top .chrome {
		margin-bottom: 20px;
	}
	h1 {
		font-size: var(--t-page);
	}
	.body {
		display: grid;
		gap: clamp(32px, 5vw, 56px);
		padding-bottom: clamp(32px, 6vw, 64px);
	}
	@media (min-width: 900px) {
		.body {
			grid-template-columns: minmax(0, 1fr) 240px;
			align-items: start;
		}
	}
	.txt > p + p {
		margin-top: 1.2em;
	}
	.txt p:not(.lead) {
		color: var(--fg-muted);
	}
	.side {
		display: grid;
		gap: 20px;
		padding: 24px;
		border: var(--hair) solid var(--rule);
		border-radius: var(--r-panel) 0 var(--r-panel) 0;
		position: sticky;
		top: 88px;
	}
	.facts div + div {
		margin-top: 14px;
	}
	.facts dt {
		color: var(--fg-muted);
		margin-bottom: 4px;
	}
	.facts dd {
		margin: 0;
		color: var(--fg);
		text-transform: none;
		letter-spacing: 0;
		font-size: var(--t-caption);
	}
	.stack-wrap {
		padding-bottom: 16px;
	}
	.lbl {
		margin-block: 24px 20px;
	}
	.cols {
		display: grid;
		gap: var(--gutter);
		grid-template-columns: repeat(auto-fit, minmax(210px, 1fr));
	}
	.sub {
		color: var(--fg);
		margin-bottom: 12px;
	}
	.chips {
		display: flex;
		flex-wrap: wrap;
		gap: 8px;
	}
	.chips li {
		border: var(--hair) solid var(--rule);
		padding: 5px 10px;
		border-radius: var(--r-control) 0 var(--r-control) 0;
	}
</style>
